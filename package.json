{
  "name": "gio-kerala",
  "version": "0.0.0",
  "private": true,
  "description": "GIO Kerala website (giokerala.org): Next.js on Cloudflare Workers",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "build:cf": "pnpm --filter web build:cf",
    "preview": "pnpm --filter web preview",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter web test",
    "db:generate": "pnpm --filter @gio/db generate",
    "db:migrate:local": "pnpm --filter web exec wrangler d1 migrations apply DB --local"
  }
}
