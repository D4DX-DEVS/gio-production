// Cloudflare configuration for the production resources (D1 gio-prod, R2 gio-media,
// gio-private and gio-kerala-opennext-cache). IDs and bucket names are not secrets;
// secrets are set with `wrangler secret put`, never here.
// `pnpm dev` and `pnpm preview` still run against local emulations in .wrangler/state/.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Custom entry: legacy WordPress URLs and /wp-content/uploads first, then OpenNext.
	// See src/legacy/.
	"main": "worker.ts",
	"name": "gio-kerala-web",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding; the service name must match the worker name.
			// See https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "gio-kerala-web"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "gio-prod",
			"database_id": "adb0fa5d-11ce-4f7b-9de8-b2bc1bca7e06",
			"migrations_dir": "../../packages/db/migrations"
		}
	],
	"r2_buckets": [
		{
			// OpenNext incremental cache (ISR / "use cache" data)
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "gio-kerala-opennext-cache"
		},
		{
			// Public media (legacy wp-content/uploads keys and new uploads)
			"binding": "MEDIA",
			"bucket_name": "gio-media"
		},
		{
			// Private bucket (snapshots, reports, backups); never served publicly
			"binding": "PRIVATE",
			"bucket_name": "gio-private"
		}
	],
	"images": {
		// Cloudflare Images binding: used by OpenNext for /_next/image and by the
		// legacy resized-image route (phase-1 spike C)
		"binding": "IMAGES"
	}
}
